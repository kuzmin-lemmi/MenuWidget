<Window x:Class="MenuWidget.Prototype.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MenuWidget · прототип" Width="570" Height="900" MinWidth="520" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F5EF" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Language="ru-RU">
  <Border Background="#F5F5EF">
  <Grid Margin="25,20" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Green}" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock Text="М" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Button Content="Настройки" Click="Settings_Click" DockPanel.Dock="Right" Padding="12,7"/>
      <StackPanel><TextBlock Text="Меню для сайта" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Пять файлов на рабочую неделю" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
    </DockPanel>
    <!-- No scrolling: on a short screen the whole page scales down instead. -->
    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
      <StackPanel Width="500">
        <StackPanel x:Name="HomePanel">
          <Button x:Name="DragProbeSource" Content="Тест: перетащите отсюда пять искусственных файлов в область ниже" Visibility="Collapsed" PreviewMouseMove="DragProbe_MouseMove" Margin="0,0,0,12"/>
          <Border Background="#E8EEE6" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <StackPanel><TextBlock x:Name="TodayText" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
          </Border>
          <TextBlock Text="Какой комплект готовим?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
          <UniformGrid Columns="2" Margin="0,0,0,15">
            <Border Background="White" CornerRadius="9" BorderBrush="#DAE2DB" BorderThickness="1" Margin="0,0,5,0"><RadioButton x:Name="FirstSet" Content="Меню 1–5" GroupName="Set" IsChecked="True" Checked="Set_Changed"/></Border>
            <Border Background="White" CornerRadius="9" BorderBrush="#DAE2DB" BorderThickness="1" Margin="5,0,0,0"><RadioButton x:Name="SecondSet" Content="Меню 6–10" GroupName="Set" Checked="Set_Changed"/></Border>
          </UniformGrid>
          <Border x:Name="DropZone" Background="White" CornerRadius="12" BorderBrush="#A7B8A9" BorderThickness="1" Padding="16,12" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
            <StackPanel><TextBlock Text="Перетащите сюда файлы меню" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FileStatus" Text="Пять файлов Excel · понедельник — пятница" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/><Button Content="Выбрать файлы" Click="Browse_Click" HorizontalAlignment="Center" Padding="17,8"/></StackPanel>
          </Border>
          <DockPanel Margin="0,16,0,10"><TextBlock Text="Неделя с понедельника" VerticalAlignment="Center" FontWeight="SemiBold"/><DatePicker x:Name="WeekPicker" AutomationProperties.Name="Понедельник целевой недели" Width="150" SelectedDateChanged="Week_Changed" HorizontalAlignment="Right"/></DockPanel>
          <Border Background="White" CornerRadius="10" BorderBrush="#E0E5DE" BorderThickness="1" Padding="12,4"><ItemsControl x:Name="DayRows"/></Border>
          <Button x:Name="SaveDraftButton" Content="Проверить порядок и сохранить шаблоны" Click="SaveDraft_Click" Visibility="Collapsed" Margin="0,10,0,0"/>
          <TextBlock x:Name="Feedback" Margin="0,10,0,10" FontSize="12" Foreground="{StaticResource Muted}"/>
          <Button x:Name="PrepareButton" Content="Подготовить 5 файлов" Background="{StaticResource Green}" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Padding="16,13" Click="Prepare_Click" IsEnabled="False"/>
          <DockPanel Margin="0,15,0,0"><TextBlock Text="Напоминание" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReminderSummary" Text="Не настроено" HorizontalAlignment="Right"/></DockPanel>
          <Button Content="Проверить обновления" Click="Updates_Click" Margin="0,10,0,0" Padding="12,9"/>
        </StackPanel>
        <StackPanel x:Name="WelcomePanel" Visibility="Collapsed">
          <TextBlock Text="Меню на неделю — за пару минут" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,12"/>
          <TextBlock Text="Добавьте два комплекта по пять файлов. Мы сохраним их и поможем подготовить новые даты." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
          <Border Background="White" CornerRadius="12" Padding="18"><StackPanel>
            <TextBlock Text="1. Загрузите меню" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Отдельно комплект 1–5 и комплект 6–10." Margin="0,6,0,20"/>
            <TextBlock Text="2. Укажите начало цикла" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Выберите понедельник недели с меню 1–5." Margin="0,6,0,20"/>
            <TextBlock Text="3. Включите напоминание" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="По воскресеньям, в удобное для вас время." Margin="0,6,0,0"/>
          </StackPanel></Border>
          <Button Content="Начать настройку" Background="{StaticResource Green}" Foreground="White" Click="Settings_Click" Margin="0,24,0,10"/>
          <Button Content="Посмотреть основной экран" Click="Home_Click"/>
          <TextBlock Text="Файлы остаются на вашем компьютере. Excel для работы программы не потребуется." Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,14"><Button Content="← Назад к меню" Click="Home_Click" Padding="12,7" DockPanel.Dock="Left"/><TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
          <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Background="White" CornerRadius="9" BorderBrush="#DAE2DB" BorderThickness="1" Margin="0,0,4,0"><RadioButton x:Name="CycleTab" Content="Цикл и папка" GroupName="SettingsTab" IsChecked="True" Checked="SettingsTab_Changed"/></Border>
            <Border Background="White" CornerRadius="9" BorderBrush="#DAE2DB" BorderThickness="1" Margin="2,0,2,0"><RadioButton x:Name="ReminderTab" Content="Напоминание" GroupName="SettingsTab" Checked="SettingsTab_Changed"/></Border>
            <Border Background="White" CornerRadius="9" BorderBrush="#DAE2DB" BorderThickness="1" Margin="4,0,0,0"><RadioButton x:Name="WidgetTab" Content="Виджет" GroupName="SettingsTab" Checked="SettingsTab_Changed"/></Border>
          </UniformGrid>
          <Border Background="White" CornerRadius="12" BorderBrush="#E0E5DE" BorderThickness="1" Padding="18,16" MinHeight="340">
            <Grid>
              <StackPanel x:Name="CycleSettings">
                <TextBlock Text="Начало цикла" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="Понедельник, когда используются меню 1–5. Каникулы и праздники не сдвигают чередование." Margin="0,6,0,10" Foreground="{StaticResource Muted}" FontSize="12"/>
                <DatePicker x:Name="AnchorPicker" AutomationProperties.Name="Понедельник начала цикла меню 1–5" Width="170" HorizontalAlignment="Left"/>
                <TextBlock Text="Папка готовых меню" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,8"/>
                <DockPanel><Button Content="Выбрать папку" Click="OutputFolder_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,7"/><TextBox x:Name="OutputPath" IsReadOnly="True" TextWrapping="NoWrap" VerticalContentAlignment="Center"/></DockPanel>
                <CheckBox x:Name="AutoStartCheck" Content="Запускать при входе в Windows" Margin="0,20,0,10"/>
                <CheckBox x:Name="TopmostCheck" Content="Поверх других окон (программа и виджет)" Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
              </StackPanel>
              <StackPanel x:Name="ReminderSettings" Visibility="Collapsed">
                <TextBlock Text="Напоминание по воскресеньям" FontWeight="SemiBold" FontSize="15"/>
                <CheckBox x:Name="ReminderEnabled" Content="Напоминать о подготовке меню" Margin="0,14,0,12"/>
                <DockPanel><TextBlock Text="Время на этом компьютере" VerticalAlignment="Center"/><TextBox x:Name="ReminderTime" AutomationProperties.Name="Время воскресного напоминания, часы и минуты" Text="18:00" Width="90" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock Text="Программа остаётся у часов после закрытия окна. Если компьютер был выключен, напоминание появится после входа в Windows. Пока вы не ответите, оно повторяется каждые 30 минут." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,16"/>
                <Button Content="Проверить уведомление" Click="TestReminder_Click" HorizontalAlignment="Left" Padding="14,8"/>
              </StackPanel>
              <StackPanel x:Name="WidgetSettings" Visibility="Collapsed">
                <Button Content="Показать виджет на рабочем столе" Click="ShowWidget_Click" Background="{StaticResource Green}" Foreground="White" Margin="0,0,0,6"/>
                <TextBlock Text="✕ на виджете скрывает его. Вернуть: эта кнопка, ярлык MenuWidget или значок у часов → «Показать виджет»." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Тема" VerticalAlignment="Center"/><ComboBox x:Name="WidgetThemeBox" AutomationProperties.Name="Тема виджета" Width="190" HorizontalAlignment="Right"><ComboBoxItem Content="Как в Windows" Tag="system"/><ComboBoxItem Content="Светлая" Tag="light"/><ComboBoxItem Content="Тёмная" Tag="dark"/></ComboBox></DockPanel>
                <DockPanel Margin="0,0,0,12"><TextBlock Text="Положение на экране" VerticalAlignment="Center"/><ComboBox x:Name="WidgetCornerBox" AutomationProperties.Name="Положение виджета" Width="190" HorizontalAlignment="Right"><ComboBoxItem Content="Справа сверху" Tag="top-right"/><ComboBoxItem Content="Справа снизу" Tag="bottom-right"/><ComboBoxItem Content="Слева сверху" Tag="top-left"/><ComboBoxItem Content="Слева снизу" Tag="bottom-left"/><ComboBoxItem Content="Куда я перетащил" Tag="custom"/></ComboBox></DockPanel>
                <TextBlock x:Name="WidgetOpacityText" Text="Непрозрачность фона: 100%"/>
                <Slider x:Name="WidgetOpacitySlider" AutomationProperties.Name="Непрозрачность фона виджета" Minimum="80" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="WidgetOpacity_Changed" Margin="0,6,0,10"/>
                <CheckBox x:Name="WidgetLockedCheck" Content="Закрепить виджет — не сдвигать мышью"/>
              </StackPanel>
            </Grid>
          </Border>
          <Button Content="Сохранить настройки" Background="{StaticResource Green}" Foreground="White" Click="Apply_Click" Margin="0,16,0,0"/>
          <TextBlock x:Name="SettingsFeedback" Text="Настройки сохраняются на этом компьютере." Foreground="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
        <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
          <Button Content="← Назад к меню" HorizontalAlignment="Left" Click="Home_Click" Padding="12,7" Margin="0,0,0,16"/>
          <TextBlock Text="Обновления" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/>
          <Border Background="#E8EEE6" Padding="18" CornerRadius="12"><StackPanel><TextBlock Text="Вы управляете обновлением" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Программа покажет новую версию и список изменений. Установка начнётся после нажатия «Установить»." Margin="0,8,0,0"/></StackPanel></Border>
          <TextBlock Text="Источник: kuzmin-lemmi/MenuWidget · Windows x64" Margin="0,18,0,10"/>
          <TextBlock x:Name="UpdateStatus" Text="Нажмите «Проверить обновления»." Margin="0,0,0,12"/>
          <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="190" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <TextBlock Margin="0,0,0,12" FontSize="12"><Hyperlink NavigateUri="https://github.com/kuzmin-lemmi/MenuWidget/releases/latest" RequestNavigate="ReleasePage_Navigate">Полное описание на GitHub</Hyperlink></TextBlock>
          <ProgressBar x:Name="UpdateProgress" Height="6" Maximum="100" Margin="0,0,0,12"/>
          <Button Content="Проверить обновления" Click="CheckAgain_Click" Margin="0,0,0,8"/>
          <Button x:Name="InstallUpdate" Content="Установить новую версию" Click="InstallUpdate_Click" IsEnabled="False" Background="{StaticResource Green}" Foreground="White"/>
          <Button x:Name="CancelUpdate" Content="Отменить" Click="CancelUpdate_Click" Visibility="Collapsed" Margin="0,8,0,0"/>
          <TextBlock Text="Во время установки программа закроется и откроется снова. Настройки и шаблоны сохранятся." Margin="0,16,0,0" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </StackPanel>
    </Viewbox>
    <StackPanel Grid.Row="2" Margin="0,15,0,0">
      <Border Height="1" Background="#DEE4DC" Margin="0,0,0,10"/>
      <DockPanel><TextBlock x:Name="VersionText" Text="MenuWidget · 0.2.0" FontSize="11" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ScenePicker" Width="156" FontSize="11" HorizontalAlignment="Right" SelectionChanged="Scene_Changed" ToolTip="Демонстрационные состояния макета"><ComboBoxItem Content="Первый запуск" Tag="welcome"/><ComboBoxItem Content="Нет файлов" Tag="empty"/><ComboBoxItem Content="Часть файлов" Tag="partial"/><ComboBoxItem Content="Комплект готов" Tag="ready"/><ComboBoxItem Content="Ошибка" Tag="error"/><ComboBoxItem Content="Настройки" Tag="settings"/><ComboBoxItem Content="Настройки виджета" Tag="settings-widget"/><ComboBoxItem Content="Обновления" Tag="updates"/></ComboBox></DockPanel>
    </StackPanel>
  </Grid>
  </Border>
</Window>
